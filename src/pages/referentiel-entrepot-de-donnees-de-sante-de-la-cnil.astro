      transition: none;
    }
  }
</style>

<script>
  (function () {
    var headings = (
      Array.prototype.slice.call(
        document.querySelectorAll("article.prose h2, article.prose h3, article.prose h4")
      ) as HTMLElement[]
    ).filter(function (h) {
      return h.getAttribute("data-toc") !== "skip";
    });

    var hitEl = document.querySelector(".outline-hit");
    var miniEl = document.getElementById("outline-mini");
    var panelEl = document.getElementById("outline-panel");
    if (!hitEl || !miniEl || !panelEl || !headings.length) return;

    var hit = hitEl;
    var mini = miniEl;
    var panel = panelEl;

    var dashes: HTMLDivElement[] = [];
    var items: HTMLAnchorElement[] = [];

    headings.forEach(function (h) {
      var level = h.tagName === "H2" ? "2" : "3";

      var dash = document.createElement("div");
      dash.className = "outline-dash";
      dash.dataset.level = level;
      dash.dataset.target = h.id;
      mini.appendChild(dash);
      dashes.push(dash);

      var item = document.createElement("a");
      item.className = "outline-item";
      item.dataset.level = level;
      item.dataset.target = h.id;
      item.href = "#" + h.id;
      var label = h.getAttribute("data-toc-label") || h.textContent || "";
      item.textContent = label;
      item.title = label;
      panel.appendChild(item);
      items.push(item);
    });

    function setActive(id: string) {
      dashes.forEach(function (d) {
        d.classList.toggle("is-active", d.dataset.target === id);
      });
      items.forEach(function (i) {
        i.classList.toggle("is-active", i.dataset.target === id);
      });
    }

    // Scroll-spy: re-checks every heading's live position on each scroll
    // frame and keeps the last one that has passed the threshold line.
    // (An IntersectionObserver only reports entries whose status *changed*
    // since the last callback, so a big jump — like scrollIntoView from a
    // click — can leave a lower heading "active" if it happened to be the
    // one reported in that batch. Recomputing from live positions avoids
    // that entirely, regardless of how the scroll happened.)
    var THRESHOLD = 96;
    var ticking = false;

    function updateActive() {
      ticking = false;
      var current = headings[0].id;
      for (var i = 0; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top - THRESHOLD <= 0) {
          current = headings[i].id;
        } else {
          break;
        }
      }
      setActive(current);
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    updateActive();

    function scrollToTarget(id: string | undefined) {
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      target.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
        block: "start",
      });
    }

    ([dashes, items] as HTMLElement[][]).forEach(function (group) {
      group.forEach(function (el) {
        el.addEventListener("click", function (e) {
          e.preventDefault();
          scrollToTarget(el.dataset.target);
        });
      });
    });

    // Soft edge fade instead of a scrollbar: mask the panel's own box so the
    // fade always sits at the visible top/bottom edge, regardless of how far
    // it's scrolled (a mask applies to the rendered viewport, not the
    // scrolled content, unlike an absolutely-positioned overlay would).
    var FADE = 22; // px
    function updatePanelMask() {
      var atTop = panel.scrollTop <= 1;
      var atBottom =
        panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 1;
      var stops = [
        atTop ? "black 0" : "transparent 0",
        atTop ? "black 0" : "black " + FADE + "px",
        atBottom ? "black 100%" : "black calc(100% - " + FADE + "px)",
        atBottom ? "black 100%" : "transparent 100%",
      ];
      var gradient = "linear-gradient(to bottom, " + stops.join(", ") + ")";
      panel.style.setProperty("mask-image", gradient);
      panel.style.setProperty("-webkit-mask-image", gradient);
    }

    panel.addEventListener("scroll", updatePanelMask, { passive: true });

    // On open, bring the active item roughly to the middle of the panel so
    // you land near "where you are" rather than always at the top of a long list.
    function revealActiveInPanel() {
      var active = panel.querySelector(".outline-item.is-active") as HTMLElement | null;
      if (active) {
        panel.scrollTop =
          active.offsetTop - panel.clientHeight / 2 + active.offsetHeight / 2;
      }
      updatePanelMask();
    }

    hit.addEventListener("mouseenter", revealActiveInPanel);
    hit.addEventListener("focusin", revealActiveInPanel);
  })();
</script>
