---
import MinimalLayout from "./MinimalLayout.astro";

export interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props.frontmatter ?? Astro.props;
---

<MinimalLayout title={title} description={description}>
  <div class="py-16">
    <div class="max-w-3xl mx-auto">
      {eyebrow && (
        <p class="font-semibold uppercase tracking-wide text-gray-400 mb-4">{eyebrow}</p>
      )}
      <article class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-[inherit] prose-a:text-gray-900 prose-a:underline prose-a:decoration-dotted prose-a:decoration-gray-400 prose-a:underline-offset-4 hover:prose-a:text-primary-600 hover:prose-a:decoration-primary-600">
        <h1 id="titre" class="not-prose text-3xl text-primary-600 mb-8">{title}</h1>
        <slot />
      </article>
    </div>
  </div>
</MinimalLayout>

<style is:global>
  /* Resserre l'écart entre un paragraphe et la liste qui le suit pour l'aligner
     sur l'écart entre deux puces (12px) : les marges verticales adjacentes
     fusionnent en prenant la plus grande des deux, donc les deux côtés doivent
     être réduits ensemble. */
  article.prose p:has(+ ul, + ol) {
    margin-bottom: 0.75rem;
  }
  article.prose p + ul,
  article.prose p + ol {
    margin-top: 0.75rem;
  }
</style>
